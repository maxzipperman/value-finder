{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/ops/cloud_setup.sh",
            "timeout": 900
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/ops/hooks/cloud_first.py\"; [ -f \"$f\" ] && [ -r \"$f\" ] || exit 0; python3 \"$f\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
