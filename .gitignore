# secrets — never commit
.env
.env.*
!.env.example

# local environments, caches
.venv/
.venv-*/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.DS_Store
.claude/settings.local.json

# downloaded / generated data (scripts re-create it), except the small
# processed datasets, which are committed so cloud sessions can run analyses
**/data/*
!**/data/processed/
*.parquet
!**/data/processed/*.parquet
*.duckdb

# third-party reference clone
sharp-markets/reference/

# thesis PDF stays local; the text version is in thesis/
*.pdf

# Acquisition state and receipts contain paid raw bodies; never publish them.
**/football-acquisition-runtime/
**/football-acquisition-state/
strategy-research/football_archive/**/spending-ledger.json
strategy-research/football_archive/**/receipts/
