{
  "version": 1,
  "scopes": [
    "dashboard/vfdash",
    "dashboard/tests",
    "dashboard/content",
    "dashboard/pyproject.toml",
    "dashboard/uv.lock",
    "dashboard/verification.json",
    "ops/process/process_guard.py",
    "STATUS.md",
    ".github/workflows/dashboard.yml"
  ],
  "commands": [
    [
      "{python}",
      "-B",
      "-m",
      "pytest",
      "dashboard/tests/test_operations.py",
      "dashboard/tests/test_api.py",
      "dashboard/tests/test_parsing.py",
      "dashboard/tests/test_readonly.py",
      "dashboard/tests/test_secrets.py",
      "dashboard/tests/test_static.py",
      "-o",
      "addopts=",
      "-q"
    ],
    [
      "node",
      "--check",
      "dashboard/vfdash/static/app.js"
    ]
  ],
  "environment": {
    "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin",
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONHASHSEED": "0",
    "PYTHONPATH": "dashboard"
  }
}
