# Copy to .env (never commit it) and fill in.

# The Odds API (https://the-odds-api.com). Live lines work on any plan; the
# historical backfill needs a paid plan.
ODDS_API_KEY=

# iPhone alerts via ntfy (https://ntfy.sh): install the ntfy app, subscribe to
# this topic. Anyone who knows the topic can read it, so keep it random.
NTFY_TOPIC=
