# Copy to .env (never committed) and fill in.

# The Odds API (https://the-odds-api.com) — historical odds need a paid plan.
ODDS_API_KEY=

# Kaggle, for the H3 splits dataset (https://www.kaggle.com/settings -> API -> Create New Token).
# A new-style token can instead live in ~/.kaggle/access_token (only you may read it: chmod 600), or in the
# environment variable KAGGLE_API_TOKEN; `markets h3-kaggle` tries that variable, then that file, then the old pair below.
KAGGLE_USERNAME=
KAGGLE_KEY=
