{
  "version": 1,
  "scopes": [
    "cfb-weather/cfbweather/__init__.py",
    "cfb-weather/cfbweather/board.py",
    "cfb-weather/cfbweather/build.py",
    "cfb-weather/cfbweather/cfbd.py",
    "cfb-weather/cfbweather/config.py",
    "cfb-weather/cfbweather/features.py",
    "cfb-weather/cfbweather/fetch.py",
    "cfb-weather/cfbweather/live.py",
    "cfb-weather/cfbweather/market.py",
    "cfb-weather/cfbweather/models.py",
    "cfb-weather/cfbweather/mos.py",
    "cfb-weather/cfbweather/notify.py",
    "cfb-weather/cfbweather/players.py",
    "cfb-weather/cfbweather/quota.py",
    "cfb-weather/cfbweather/runlog.py",
    "cfb-weather/cfbweather/weather.py",
    "cfb-weather/scripts/poll_triggers.py",
    "cfb-weather/tests/test_live.py",
    "cfb-weather/tests/test_oddsapi.py",
    "cfb-weather/tests/test_quota.py",
    "cfb-weather/tests/test_collector_callers.py",
    "cfb-weather/requirements.txt",
    "ops/collector-safety/cfbweather-verification.json",
    "ops/collector_guard.py",
    "ops/install_live_uses.sh",
    "ops/process/process_guard.py",
    ".github/workflows/collector-safety.yml",
    "GOVERNANCE.md"
  ],
  "commands": [
    [
      "{python}",
      "-B",
      "-m",
      "pytest",
      "cfb-weather/tests/test_live.py",
      "cfb-weather/tests/test_oddsapi.py",
      "cfb-weather/tests/test_quota.py",
      "cfb-weather/tests/test_collector_callers.py",
      "-q"
    ]
  ],
  "environment": {
    "PYTHONPATH": "cfb-weather:.",
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONHASHSEED": "0"
  }
}
