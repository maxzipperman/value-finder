# Copy to .env (never commit it) and fill in.

# The Odds API (https://the-odds-api.com). Live lines work on any plan (1 credit a call);
# the historical endpoints need a paid plan. The alerts read this key.
ODDS_API_KEY=

# CollegeFootballData API (https://collegefootballdata.com/key), free tier 1,000 calls/month.
# scripts/fetch_cfbd.py reads it.
CFBD_API_KEY=

# iPhone alerts via ntfy (https://ntfy.sh): the same topic as nfl-weather's .env.
NTFY_TOPIC=
